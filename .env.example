# Habilita rota de download em sharepoints
NODE_ENV=busca-ligacoes      

# # Comando para rodar em modeo HTTPS — Caddy na 80/443, app apenas na rede interna
# docker compose -f docker-compose.yml -f docker-compose.https.yml up -d --build
# PUBLIC_HOST=localhost            
# PUBLIC_PROTOCOL=https
# PORT=80

# # Comando para rodar em modo HTTP — app exposta na porta 3000
# docker compose -f docker-compose.yml -f docker-compose.http.yml up -d --build
PUBLIC_HOST=localhost            
PUBLIC_PROTOCOL=http
PORT=3000              # Porta para exibir no log (opcional — fallback: 80)

# AWS S3
AWS_ACCESS_KEY_ID=SUA_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=SEU_SECRET_KEY
AWS_BUCKET_NAME=nome-do-bucket   # Nome simples ou s3://meu-bucket
AWS_REGION=sa-east-1             # Ex: us-east-1, sa-east-1

# Busca Local — IDs aleatórios para teste
PATH_X5=/sharepoint/backupligacoes
YEARS_X5=2021,2022,2023,2024

PATH_Z2=/sharepoint/share,subfolder1;subfolder2
YEARS_Z2=2019,2020,2021

## Segurança
JWT_SECRET=minha-chave-super-secreta
API_KEY=key-para-n8n
ADMIN_KEY=chave-para-criar-usuarios
# secure:true no cookie e HSTS ativam automaticamente com Caddy (req.protocol)